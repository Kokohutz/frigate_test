#!/command/with-contenv bash
# shellcheck shell=bash
# Start the encrypted-storage Rust daemon (requires STORAGE_ENCRYPTION_KEY)

set -o errexit -o nounset -o pipefail

exec 2>&1

if [[ -z "${STORAGE_ENCRYPTION_KEY:-}" ]]; then
    echo "[INFO] encrypted-storage: STORAGE_ENCRYPTION_KEY not set — daemon disabled."
    exit 0
fi

echo "[INFO] Starting encrypted-storage..."
exec /usr/local/bin/encrypted-storage
