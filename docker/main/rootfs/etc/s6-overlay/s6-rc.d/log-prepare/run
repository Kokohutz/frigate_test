#!/command/with-contenv bash
# shellcheck shell=bash
# Prepare the logs folder for s6-log

set -o errexit -o nounset -o pipefail

dirs=(
    /dev/shm/logs/frigate
    /dev/shm/logs/go2rtc
    /dev/shm/logs/nginx
    /dev/shm/logs/certsync
    /dev/shm/logs/storage-daemon
    /dev/shm/logs/comms-dispatcher
    /dev/shm/logs/encrypted-storage
    /dev/shm/logs/tiered-storage
    /dev/shm/logs/detection-bridge
    /dev/shm/logs/event-router
)

mkdir -p "${dirs[@]}"
chown nobody:nogroup "${dirs[@]}"
chmod 02755 "${dirs[@]}"
