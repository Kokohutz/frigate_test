#!/command/with-contenv bash
# shellcheck shell=bash
# Start the tiered-storage Rust daemon (requires cold tier path)

set -o errexit -o nounset -o pipefail

exec 2>&1

if [[ -z "${COLD_PATH:-}" ]]; then
    echo "[INFO] tiered-storage: COLD_PATH not set — daemon disabled."
    exit 0
fi

echo "[INFO] Starting tiered-storage..."
exec /usr/local/bin/tiered-storage
